            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Q4 Sprint Planning & Architectural Review\",\n  \"content\": \"<h2>Sprint Objectives</h2><p>1. Finish authentication module</p><p>2. Complete rich text note editor</p><p>3. Add full text search and categories filter</p>\",\n  \"category\": \"Work\",\n  \"isPinned\": true,\n  \"color\": \"blue\",\n  \"tags\": [\"sprint\", \"planning\", \"engineering\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notes"]
            }
          },
          "response": []
